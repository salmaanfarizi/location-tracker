# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Google Sheets Apps Script Web App URL
# Deploy your Apps Script and paste the Web App URL here
GOOGLE_APPS_SCRIPT_URL=YOUR_GOOGLE_APPS_SCRIPT_URL_HERE

# Google Sheet ID (optional - for future features)
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# App Configuration
APP_NAME=Al Hasa Grocery Tracker
DEFAULT_LATITUDE=25.4295
DEFAULT_LONGITUDE=49.5815
